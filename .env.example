# Optional. NYC Geoservice currently requires a subscription key.
NYC_LENS_GEOSERVICE_KEY=

# Optional. MTA Bus Time requires an operator-created account and API key.
MTA_BUS_TIME_API_KEY=

# Optional overrides. Defaults remain inside this project directory.
# Config YAML under NYC_LENS_HOME/config is captured once per analysis/comparison.
# Edits apply to the next request. Finish multi-file edits while analysis is idle;
# file-size limits and recovery steps are in docs/configuration-snapshots-2026-10-29.md.
# Restart the service after code or process-environment changes.
# External refreshes retain immutable generations under this home. Back up the
# closed catalog and referenced files together; no automatic generation cleanup.
# See docs/external-generations-2026-10-31.md before upgrading a populated home.
# Restaurant/hotel/air refresh exports now use snapshot-specific paths, returned
# as standardized_parquet; old current/ files remain unchanged. No new variable.
# See docs/socrata-publication-2026-10-31.md for atomic refresh scope and recovery.
# Geography/hazard refreshes retain response count/ID checks and fail before
# publication when coverage is unverified; no override or new setting is needed.
# See docs/geojson-completeness-2026-10-31.md for explicit retry and audit paths.
# FEMA now verifies pre/post membership and exact ID pages; there is no bypass.
# On Windows without long-path support, choose a short NYC_LENS_HOME containing
# the required config/ files before initializing a new catalog. A deep checkout
# plus dated raw-snapshot paths can exceed the host's file-path limit. Changing
# this variable does not migrate an existing catalog or its referenced files.
# See docs/fema-membership-2026-10-31.md for the observed path failure and limits.
# Web, HTTP, MCP, CLI analysis and run_analysis_sync use fixed defaults: 120 seconds,
# 2048 MiB OS guard; DuckDB 512 MiB buffer, 2 threads, 1024 MiB spill.
# These are not model/tool parameters. Windows and Linux guards are implemented;
# other platforms refuse bounded analysis. Low-level connection-based library
# calls, ingestion and export remain direct. CLI request IDs are not budgets.
# See docs/bounded-cli-analysis-2026-10-30.md.
NYC_LENS_HOME=
NYC_LENS_DATABASE=
# TIGER block groups/FEMA SFHA exports now live beneath their ingestion-run ID.
# Consume standardized_parquet from a successful refresh, not the old fixed path.
# publication_manifest is locally derived; ingestion_run.status determines use.
# No new setting. See docs/multisnapshot-publication-2026-10-31.md for recovery.

# Public read-only endpoints. Change only when an operator has reviewed the endpoint.
NYC_LENS_OVERPASS_URL=https://overpass-api.de/api/interpreter
NYC_LENS_USER_AGENT=NYC-Lens/0.2 local-research

# Optional requirement interpretation only. Disabled requires no model/account.
# Values: disabled, loopback, openai. Analysis stays in the local query engine.
NYC_LENS_AI_PROVIDER=disabled
NYC_LENS_AI_MODEL=
NYC_LENS_AI_URL=http://127.0.0.1:1234/v1/chat/completions
# Only explicit true permits sending entered requirements/addresses to OpenAI.
# The database and query results are not included. API billing may apply.
NYC_LENS_ALLOW_CLOUD=false
OPENAI_API_KEY=
